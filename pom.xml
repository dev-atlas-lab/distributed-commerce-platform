<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.4</version>
        <relativePath/>
    </parent>

    <groupId>com.devatlas.commerce</groupId>
    <artifactId>distributed-commerce-platform-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Distributed Commerce &amp; Flash Sale Platform — Java Parent</name>
    <description>Polyglot Java 21 + Spring Boot 3.4 foundation for Catalog, Inventory, Order, and Payment services.</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <springdoc.version>2.8.5</springdoc.version>
    </properties>

    <modules>
        <module>src/building-blocks/java</module>
        <module>src/services/catalog</module>
        <module>src/services/inventory</module>
        <module>src/services/order</module>
        <module>src/services/payment</module>
        <module>tests/architecture</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.devatlas.commerce</groupId>
                <artifactId>commerce-building-blocks</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
