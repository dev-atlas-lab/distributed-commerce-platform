# =============================================================================
# Distributed Commerce & Flash Sale Platform — Local Development Environment
# Copy this file to `.env` for local development. NEVER commit real secrets!
# =============================================================================

# --- Environment Profile ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL 17 Consolidated Instance (ADR-0002) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=dev_postgres_root_change_me

PRODUCT_DB_NAME=product_db
PRODUCT_DB_USER=product_svc_user
PRODUCT_DB_PASSWORD=dev_product_pass_change_me

CUSTOMER_DB_NAME=customer_db
CUSTOMER_DB_USER=customer_svc_user
CUSTOMER_DB_PASSWORD=dev_customer_pass_change_me

ORDER_DB_NAME=order_db
ORDER_DB_USER=order_svc_user
ORDER_DB_PASSWORD=dev_order_pass_change_me

INVENTORY_DB_NAME=inventory_db
INVENTORY_DB_USER=inventory_svc_user
INVENTORY_DB_PASSWORD=dev_inventory_pass_change_me

PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USER=payment_svc_user
PAYMENT_DB_PASSWORD=dev_payment_pass_change_me

PROMOTION_DB_NAME=promotion_db
PROMOTION_DB_USER=promotion_svc_user
PROMOTION_DB_PASSWORD=dev_promotion_pass_change_me

AI_AGENT_DB_NAME=ai_agent_db
AI_AGENT_DB_USER=ai_agent_svc_user
AI_AGENT_DB_PASSWORD=dev_ai_agent_pass_change_me

# --- Redis 7.4 ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=dev_redis_pass_change_me

# --- Apache Kafka 3.8 (KRaft Mode — ADR-0010) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- MinIO S3-Compatible Object Storage ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=dev_minio_pass_change_me
MINIO_PRODUCT_MEDIA_BUCKET=product-media

# --- Mailpit Local SMTP ---
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- OIDC / JWT Authentication (ADR-0006) ---
AUTH_ISSUER_URI=http://localhost:5001
AUTH_JWKS_URI=http://localhost:5001/.well-known/jwks.json
AUTH_AUDIENCE=commerce-api

# --- Payment Simulator ---
PAYMENT_WEBHOOK_HMAC_SECRET=dev_webhook_hmac_secret_change_me

# --- AI Agent Service (ADR-0008) ---
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL_NAME=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_EMBEDDING_DIMENSIONS=1536

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
