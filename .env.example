# =============================================================================
# Distributed Commerce & Flash Sale Platform — Local Development Environment
# Copy this file to `.env` for local development (`cp .env.example .env`).
# NEVER commit `.env` or real credentials to Git!
# =============================================================================

# --- Environment Profile ---
ENVIRONMENT=development
LOG_LEVEL=INFO
FAULT_INJECTION_ENABLED=false

# --- PostgreSQL 17 Consolidated Instance (ADR-0002 & ADR-0005) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=placeholder_postgres_superuser_replace_me

# Catalog Service Database (Application Role + Dedicated Migration Role)
CATALOG_DB_NAME=catalog_db
CATALOG_DB_USER=catalog_svc_user
CATALOG_DB_PASSWORD=placeholder_catalog_db_replace_me
CATALOG_MIGRATOR_USER=catalog_migrator
CATALOG_MIGRATOR_PASSWORD=placeholder_catalog_migrator_replace_me

# Customer & Identity Service Database (Application Role + Dedicated Migration Role)
CUSTOMER_DB_NAME=customer_db
CUSTOMER_DB_USER=customer_svc_user
CUSTOMER_DB_PASSWORD=placeholder_customer_db_replace_me
CUSTOMER_MIGRATOR_USER=customer_migrator
CUSTOMER_MIGRATOR_PASSWORD=placeholder_customer_migrator_replace_me

# Order & Saga Service Database (Application Role + Dedicated Migration Role)
ORDER_DB_NAME=order_db
ORDER_DB_USER=order_svc_user
ORDER_DB_PASSWORD=placeholder_order_db_replace_me
ORDER_MIGRATOR_USER=order_migrator
ORDER_MIGRATOR_PASSWORD=placeholder_order_migrator_replace_me

# Inventory Service Database (Application Role + Dedicated Migration Role)
INVENTORY_DB_NAME=inventory_db
INVENTORY_DB_USER=inventory_svc_user
INVENTORY_DB_PASSWORD=placeholder_inventory_db_replace_me
INVENTORY_MIGRATOR_USER=inventory_migrator
INVENTORY_MIGRATOR_PASSWORD=placeholder_inventory_migrator_replace_me

# Payment Service Database (Application Role + Dedicated Migration Role)
PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USER=payment_svc_user
PAYMENT_DB_PASSWORD=placeholder_payment_db_replace_me
PAYMENT_MIGRATOR_USER=payment_migrator
PAYMENT_MIGRATOR_PASSWORD=placeholder_payment_migrator_replace_me

# Promotion & Flash Sale Database — 4-Role Least-Privilege Separation (ADR-0005 / CH-01)
PROMOTION_DB_NAME=promotion_db
PROMOTION_PROC_OWNER_ROLE=promotion_proc_owner
PROMOTION_MIGRATOR_USER=promotion_migrator
PROMOTION_MIGRATOR_PASSWORD=placeholder_promotion_migrator_replace_me
PROMOTION_APP_USER=promotion_app_role
PROMOTION_APP_PASSWORD=placeholder_promotion_app_replace_me
PROMOTION_DBA_ADMIN_USER=promotion_dba_admin
PROMOTION_DBA_ADMIN_PASSWORD=placeholder_promotion_dba_admin_replace_me

# Notification Service Database (Application Role + Dedicated Migration Role)
NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification_svc_user
NOTIFICATION_DB_PASSWORD=placeholder_notification_db_replace_me
NOTIFICATION_MIGRATOR_USER=notification_migrator
NOTIFICATION_MIGRATOR_PASSWORD=placeholder_notification_migrator_replace_me

# AI Worker Service Database (pgvector — Application Role + Dedicated Migration Role)
AI_AGENT_DB_NAME=ai_agent_db
AI_AGENT_DB_USER=ai_agent_svc_user
AI_AGENT_DB_PASSWORD=placeholder_ai_agent_db_replace_me
AI_AGENT_MIGRATOR_USER=ai_agent_migrator
AI_AGENT_MIGRATOR_PASSWORD=placeholder_ai_agent_migrator_replace_me

# --- Redis 7.4 (ADR-0005) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=placeholder_redis_password_replace_me

# --- Apache Kafka 3.8+ (KRaft Mode, No ZooKeeper — ADR-0010) ---
KAFKA_HOST=localhost
KAFKA_EXTERNAL_PORT=9092
KAFKA_INTERNAL_PORT=29092
KAFKA_CONTROLLER_PORT=9093
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# --- OIDC / JWT Authentication (ADR-0006 — Split Logical Issuer vs Internal JWKS URL) ---
AUTH_ISSUER_URI=https://auth.commerce.dev-atlas.lab
AUTH_JWKS_URI=http://localhost:5001/.well-known/jwks.json
AUTH_AUDIENCE=commerce-api

# --- Payment Simulator Webhook Secret ---
PAYMENT_WEBHOOK_HMAC_SECRET=placeholder_webhook_hmac_secret_replace_me

# --- AI Worker Provider Abstraction (ADR-0008: openai | gemini | anthropic) ---
AI_PROVIDER=openai
OPENAI_API_KEY=placeholder_openai_api_key_replace_me
OPENAI_MODEL_NAME=gpt-4o-mini
GEMINI_API_KEY=placeholder_gemini_api_key_replace_me
GEMINI_MODEL_NAME=gemini-2.5-flash
ANTHROPIC_API_KEY=placeholder_anthropic_api_key_replace_me
ANTHROPIC_MODEL_NAME=claude-3-5-sonnet-latest
AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=768

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
